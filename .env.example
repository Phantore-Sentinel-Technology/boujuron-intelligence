# Application
APP_NAME=Phantore Sentinel
ENVIRONMENT=development
DEBUG=true

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVER=pkc-xxxxx.kafka.cloud:9092
KAFKA_TOPIC_EVENTS=user_events
KAFKA_API_KEY=your_kafka_api_key
KAFKA_API_SECRET=your_kafka_api_secret

# Database
DATABASE_URL=postgresql://user:password@host:5432/phantore

# API Security
API_KEY=your_api_key_here